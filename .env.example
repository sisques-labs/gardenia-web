# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# NEXT_PUBLIC_* are embedded at build time and exposed to the browser.
# Use URLs the browser can reach (not Docker service hostnames).

# REST API (Nest global prefix /api). Alpha compose exposes API on host port 3000.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# GraphQL (Nest default path /graphql, not under /api).
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:3000/graphql
